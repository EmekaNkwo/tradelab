{
  "title": "TradeLab companies",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "sector": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "type": "string",
      "minLength": 1
    },
    "currency": {
      "type": "string",
      "const": "USD"
    },
    "sharePrice": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "sharesOutstanding": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "years": {
      "minItems": 2,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "revenue": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "costOfSales": {
            "type": "number",
            "minimum": 0
          },
          "operatingExpenses": {
            "type": "number",
            "minimum": 0
          },
          "interest": {
            "type": "number",
            "minimum": 0
          },
          "tax": {
            "type": "number"
          },
          "operatingCashFlow": {
            "type": "number"
          },
          "capitalExpenditure": {
            "type": "number",
            "minimum": 0
          },
          "dividendsPaid": {
            "type": "number",
            "minimum": 0
          },
          "cash": {
            "type": "number",
            "minimum": 0
          },
          "debt": {
            "type": "number",
            "minimum": 0
          },
          "equity": {
            "type": "number"
          }
        },
        "required": [
          "label",
          "revenue",
          "costOfSales",
          "operatingExpenses",
          "interest",
          "tax",
          "operatingCashFlow",
          "capitalExpenditure",
          "dividendsPaid",
          "cash",
          "debt",
          "equity"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "glossaryIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    }
  },
  "required": [
    "id",
    "name",
    "sector",
    "summary",
    "assumptions",
    "currency",
    "sharePrice",
    "sharesOutstanding",
    "years",
    "notes",
    "glossaryIds"
  ],
  "additionalProperties": false
}
