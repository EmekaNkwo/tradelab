{
  "title": "TradeLab redFlagCases",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "company": {
      "type": "string",
      "minLength": 1
    },
    "facts": {
      "minItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "label",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "signs": {
      "minItems": 4,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z]$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "isRedFlag": {
            "type": "boolean"
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "text",
          "isRedFlag",
          "explanation"
        ],
        "additionalProperties": false
      }
    },
    "investigate": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verdict": {
      "type": "string",
      "minLength": 1
    },
    "glossaryIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    }
  },
  "required": [
    "id",
    "title",
    "company",
    "facts",
    "question",
    "signs",
    "investigate",
    "verdict",
    "glossaryIds"
  ],
  "additionalProperties": false
}
