{
  "title": "TradeLab sources",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "publisher": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "url": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "publishedOn": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "book",
        "interview",
        "article",
        "academic",
        "regulator",
        "dataset",
        "website",
        "other"
      ]
    },
    "quality": {
      "type": "string",
      "enum": [
        "primary",
        "strong_secondary",
        "limited_or_disputed"
      ]
    },
    "claimsSupported": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "string",
      "minLength": 1
    },
    "lastVerifiedOn": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "humanReviewed": {
      "type": "boolean"
    },
    "reviewedBy": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "reviewedAt": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "relatedStrategyIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "relatedTraderIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "disagreements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "sourceId",
          "note"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "title",
    "author",
    "publisher",
    "url",
    "publishedOn",
    "type",
    "quality",
    "claimsSupported",
    "limitations",
    "lastVerifiedOn",
    "humanReviewed",
    "reviewedBy",
    "reviewedAt",
    "relatedStrategyIds",
    "relatedTraderIds",
    "disagreements"
  ],
  "additionalProperties": false
}
