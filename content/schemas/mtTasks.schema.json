{
  "title": "TradeLab mtTasks",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "requiresDemo": {
      "type": "boolean"
    },
    "steps": {
      "minItems": 1,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "mt4": {
            "type": "string",
            "minLength": 1
          },
          "mt5": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      }
    },
    "afterQuestions": {
      "minItems": 1,
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "minItems": 2,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "explanation": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "text",
                "explanation"
              ],
              "additionalProperties": false
            }
          },
          "correctOptionIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "level": {
            "type": "string",
            "enum": [
              "beginner",
              "intermediate",
              "advanced"
            ]
          },
          "glossaryIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "skills": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "market_fundamentals",
                "chart_reading",
                "technical_analysis",
                "fundamental_analysis",
                "risk_management",
                "strategy_understanding",
                "execution_discipline",
                "psychology",
                "backtesting_literacy",
                "statistical_reasoning"
              ]
            }
          }
        },
        "required": [
          "id",
          "prompt",
          "options",
          "correctOptionIds",
          "level",
          "glossaryIds"
        ],
        "additionalProperties": false
      }
    },
    "glossaryIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    }
  },
  "required": [
    "id",
    "title",
    "summary",
    "level",
    "requiresDemo",
    "steps",
    "afterQuestions",
    "glossaryIds"
  ],
  "additionalProperties": false
}
