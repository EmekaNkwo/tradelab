{
  "title": "TradeLab disclosures",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "body": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "triggers": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "first_launch",
          "futures",
          "penny_stocks",
          "leverage",
          "final_module",
          "always"
        ]
      }
    },
    "statistics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "sourceId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "jurisdiction": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "publishedOn": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "verifiedOn": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "productsCovered": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "statement",
          "sourceId",
          "jurisdiction",
          "provider",
          "publishedOn",
          "verifiedOn",
          "productsCovered"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "version",
    "title",
    "body",
    "triggers",
    "statistics"
  ],
  "additionalProperties": false
}
